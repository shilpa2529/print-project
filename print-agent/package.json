{
  "name": "quickprint-agent",
  "version": "1.0.0",
  "description": "QuickPrint local desktop print agent",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "dev": "node --watch agent.js",
    "pkg": "pkg agent.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output dist/quickprint-agent"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
